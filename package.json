{
  "name": "blockfont",
  "version": "0.1.0",
  "private": true,
  "description": "Générateur TypeScript de polices OpenType fidèles au renderer vanilla Minecraft.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "blockfont": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli/index.js",
    "cli": "node dist/cli/index.js",
    "typecheck": "tsc --noEmit",
    "build:release-fonts": "bun src/build-release-fonts.ts",
    "pretest": "bun run build",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "opentype.js": "1.3.4",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/opentype.js": "^1.3.10",
    "@types/pngjs": "^6.0.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
